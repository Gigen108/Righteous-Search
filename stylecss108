html, body {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: white;
}

/* Keep site content above wheel */
header, main, footer {
  position: relative;
  z-index: 1;
}

/* Let mantra field show through */
header, footer {
  background: transparent;
}

main {
  padding: 20px;
  background: transparent;
}

/* Optional readability blocks */
.intro,
.post-preview {
  background: rgba(255,255,255,0.55);
  padding: 18px;
  margin-bottom: 20px;
}
